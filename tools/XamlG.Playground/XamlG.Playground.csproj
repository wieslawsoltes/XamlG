<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishTrimmed>false</PublishTrimmed>
    <RunAOTCompilation>false</RunAOTCompilation>
    <WasmBuildNative>true</WasmBuildNative>
    <WasmEnableThreads>false</WasmEnableThreads>
    <EnableAvaloniaXamlCompilation>false</EnableAvaloniaXamlCompilation>
    <AvaloniaNameGeneratorIsEnabled>false</AvaloniaNameGeneratorIsEnabled>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/XamlG.ProjectSystem/XamlG.ProjectSystem.csproj" />
    <ProjectReference Include="../../src/XamlG.IntelligentUI.Avalonia/XamlG.IntelligentUI.Avalonia.csproj" />
    <ProjectReference Include="../../src/XamlG.Tooling/XamlG.Tooling.csproj" />
    <ProjectReference Include="../../src/XamlG.Frameworks/XamlG.Frameworks.csproj" />
    <ProjectReference Include="../../src/XamlG.AvaloniaRuntime/XamlG.AvaloniaRuntime.csproj" />
    <ProjectReference Include="../../src/XamlG.Automation/XamlG.Automation.csproj" />
    <ProjectReference Include="../../src/XamlG.Agents.OpenAI/XamlG.Agents.OpenAI.csproj" />
    <ProjectReference Include="../../src/XamlG.Agents.Anthropic/XamlG.Agents.Anthropic.csproj" />
    <ProjectReference Include="../../src/XamlG.Agents.Gemini/XamlG.Agents.Gemini.csproj" />
    <PackageReference Include="Dockyard.Blazor" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <PackageReference Include="Avalonia.Browser" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Themes.Simple" />
  </ItemGroup>
  <Target Name="PublishCompilerMetadata" AfterTargets="Publish" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <CompilerMetadata Include="@(ReferencePath)" Condition="'%(ReferencePath.Extension)' == '.dll'" />
    </ItemGroup>
    <MakeDir Directories="$(PublishDir)wwwroot/references" />
    <Copy SourceFiles="@(CompilerMetadata)" DestinationFiles="@(CompilerMetadata->'$(PublishDir)wwwroot/references/%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <WriteLinesToFile File="$(PublishDir)wwwroot/references/index.txt" Lines="@(CompilerMetadata->'%(Filename)%(Extension)')" Overwrite="true" Encoding="UTF-8" />
  </Target>
  <!-- The execution worker receives only published runtime/compiler bytes. A manifest avoids
       arbitrary path discovery or network access from evaluated code. -->
  <Target Name="PublishIsolatedExecutionInventory" AfterTargets="Publish" DependsOnTargets="PublishCompilerMetadata">
    <ItemGroup>
      <_ExecutionFramework Include="$(PublishDir)wwwroot/_framework/**/*.js;$(PublishDir)wwwroot/_framework/**/*.wasm;$(PublishDir)wwwroot/_framework/**/*.dll;$(PublishDir)wwwroot/_framework/**/*.dat;$(PublishDir)wwwroot/_framework/**/*.json" />
      <_ExecutionMetadata Include="$(PublishDir)wwwroot/references/*.dll;$(PublishDir)wwwroot/references/index.txt" />
    </ItemGroup>
    <WriteLinesToFile File="$(PublishDir)wwwroot/ui-execution-assets.txt" Lines="@(_ExecutionFramework->'_framework/%(RecursiveDir)%(Filename)%(Extension)');@(_ExecutionMetadata->'references/%(Filename)%(Extension)')" Overwrite="true" Encoding="UTF-8" />
  </Target>
</Project>
