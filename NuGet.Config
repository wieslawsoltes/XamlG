<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Match the pinned Avalonia checkout's source key as well as its URL.
         NuGet deduplicates graph sources by URL, but package source mappings use keys. -->
    <add key="api.nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
