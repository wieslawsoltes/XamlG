@using System.Text.Json
@using XamlG.IntelligentUI
@using XamlG.Automation
@implements IAsyncDisposable
@inject IJSRuntime JavaScript
@inject NavigationManager Navigation
@inject IntelligentUiWorkspaceContext Workspace
<details class="ui-full-csharp"><summary>Full C# execution · owner review required</summary>
    <p>Full Roslyn C# runs in a disposable opaque-origin frame, not in the editor. It receives no provider keys, agent permissions or workspace-storage access. The frame is not a hard CPU/memory sandbox. Only run code you trust.</p>
    @foreach (var proposal in Workspace.Proposals?.SnapshotLocal() ?? [])
    { <button disabled="@_running" @onclick="() => SelectProposal(proposal)">Review proposal @proposal.Id[..8] · @proposal.Status</button> }
    <button disabled="@(_running || Workspace.Proposals?.SnapshotLocal().Count is not > 0)" @onclick="ClearProposals">Clear C# proposals</button>
    <label>Intelligent XAML with full C#<textarea aria-label="Full C# intelligent XAML" @bind="_xaml" @bind:event="oninput" @bind:after="InvalidateReview" disabled="@_running"></textarea></label>
    <label>Initial state JSON<textarea aria-label="Full C# initial state" @bind="_state" @bind:event="oninput" @bind:after="InvalidateReview" disabled="@_running"></textarea></label>
    <label>Data JSON<textarea aria-label="Full C# data" @bind="_data" @bind:event="oninput" @bind:after="InvalidateReview" disabled="@_running"></textarea></label>
    <button @onclick="Review" disabled="@_running">Review full C#</button><button @onclick="ResetAsync">Reset execution frame</button>
    @if (_reviewed != null)
    {
        <section aria-label="Review full C# execution"><h3>Review exact source and data</h3><pre>@_reviewed.Xaml</pre><pre>@_reviewed.InitialState</pre><pre>@_reviewed.Data</pre>
            <p>Hash: <code>@_reviewHash</code>. Expressions run again when you interact with this UI.</p>
            <button @onclick="RunApprovedAsync" disabled="@_running">Approve and run full C#</button>
        </section>
    }
    <p role="status">@_status</p>@if (_error != null) { <pre role="alert">@_error</pre> }
    <div @ref="_host"></div>
</details>
@code {
    private ElementReference _host;
    private IJSObjectReference? _module, _frame;
    private UiPublish? _reviewed;
    private UiCSharpProposal? _proposal;
    private string? _error, _reviewHash;
    private string _status = "No code has run.";
    private string _state = "{\"n\":3}", _data = "{}";
    private string _xaml = UiCSharpExamples.Sum().Xaml;
    private bool _running, _disposed;
    private long _generation;
    private CancellationToken _workspaceToken;
    private CancellationTokenRegistration _workspaceCancellation;
    protected override void OnInitialized() { Workspace.Changed += WorkspaceChanged; WatchWorkspace(); }
    private void WorkspaceChanged()
    { if (!_disposed) _ = InvokeAsync(() => { WatchWorkspace(); StateHasChanged(); }); }
    private void WatchWorkspace()
    {
        var token = Workspace.Lifetime;
        if (token == _workspaceToken) return;
        _workspaceCancellation.Dispose(); _workspaceToken = token;
        _workspaceCancellation = token.Register(() =>
        {
            if (!_disposed) _ = InvokeAsync(async () =>
            {
                if (_disposed) return;
                InvalidateReview();
                try { await ResetAsync(); } catch (JSException error) { _error = error.Message; }
                StateHasChanged();
            });
        });
    }
    private void InvalidateReview() { _reviewed = null; _reviewHash = null; _proposal = null; }
    private void ClearProposals() { if (_running) return; InvalidateReview(); Workspace.Proposals?.ClearLocal(); }
    private void SelectProposal(UiCSharpProposal proposal)
    {
        InvalidateReview(); _proposal = proposal; _xaml = proposal.Request.Xaml;
        _state = proposal.Request.InitialState?.GetRawText() ?? "{}"; _data = proposal.Request.Data?.GetRawText() ?? "{}";
    }
    private void Review()
    {
        try
        {
            WatchWorkspace(); _workspaceToken.ThrowIfCancellationRequested(); _error = null;
            if (_xaml.Length > 65536 || _state.Length > 131072 || _data.Length > 131072) throw new InvalidOperationException("The declaration exceeds its bounds.");
            using var state = JsonDocument.Parse(_state); using var data = JsonDocument.Parse(_data);
            if (state.RootElement.ValueKind != JsonValueKind.Object || data.RootElement.ValueKind != JsonValueKind.Object) throw new InvalidOperationException("State and data must be objects.");
            _reviewed = _proposal?.Request ?? new("approved-" + Guid.NewGuid().ToString("N"), 0, 1, _xaml, state.RootElement.Clone(), data.RootElement.Clone(), []);
            var json = JsonSerializer.Serialize(_reviewed, AutomationJson.Options);
            _reviewHash = Convert.ToHexStringLower(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(json)));
        }
        catch (Exception error) { _reviewed = null; _error = error.Message; }
    }
    private async Task RunApprovedAsync()
    {
        if (_running || _reviewed == null || _disposed || _workspaceToken.IsCancellationRequested) return;
        var request = _reviewed; var proposal = _proposal; _reviewed = null;
        await ResetAsync(); var generation = _generation; _running = true; _error = null; _status = "Starting approved execution…";
        try
        {
            _module ??= await JavaScript.InvokeAsync<IJSObjectReference>("import", "./ui-execution-client.js");
            _workspaceToken.ThrowIfCancellationRequested();
            var frame = await _module.InvokeAsync<IJSObjectReference>("create", _host, Navigation.BaseUri);
            if (_disposed || generation != _generation || _workspaceToken.IsCancellationRequested)
            { await frame.InvokeVoidAsync("dispose"); await frame.DisposeAsync(); return; }
            _frame = frame;
            var result = await frame.InvokeAsync<JsonElement>("execute", request);
            if (_disposed || generation != _generation || _workspaceToken.IsCancellationRequested) return;
            _status = "Full C# executed in the isolated frame. " + result.GetProperty("fallbackMarkdown").GetString();
            if (proposal != null) Workspace.Proposals?.CompleteLocal(proposal.Id, proposal.Sha256, result, null);
        }
        catch (Exception error)
        {
            if (!_disposed && generation == _generation)
            {
                _error = error.Message; _status = "Approved execution failed.";
                if (proposal != null) { try { Workspace.Proposals?.CompleteLocal(proposal.Id, proposal.Sha256, null, error.Message); } catch (UiException) { } }
            }
        }
        finally { if (generation == _generation) _running = false; }
    }
    private async Task ResetAsync()
    {
        _generation++; _running = false;
        var frame = _frame; _frame = null;
        if (frame != null) { await frame.InvokeVoidAsync("dispose"); await frame.DisposeAsync(); }
        _status = "Execution frame discarded. No execution grant is retained.";
    }
    public async ValueTask DisposeAsync()
    {
        if (_disposed) return; _disposed = true;
        _workspaceCancellation.Dispose(); Workspace.Changed -= WorkspaceChanged; await ResetAsync();
        if (_module != null) await _module.DisposeAsync();
    }
}
