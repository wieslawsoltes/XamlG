@implements IAsyncDisposable
@inject IJSRuntime JavaScript

<section class="agent-workbench" aria-label="Coding agent workbench">
    <header class="agent-heading"><h2>CODING AGENT</h2><button @onclick="RefreshAsync" disabled="@_refreshing">Refresh</button></header>
    @if (!_connected)
    {
        <p class="empty">Enable Agent access and connect the local companion to run coding agents. Provider keys stay in the companion environment.</p>
    }
    else
    {
        @if (_state.ChatGptError != null) { <p role="status">@_state.ChatGptError</p> }
        @if (_state.ChatGpt is { } accounts)
        {
            <details class="agent-accounts" open="@(_provider == ChatGptProvider && ActiveAccount is not { SignedIn: true, PlanEnabled: true })"><summary>ChatGPT accounts</summary>
                <p>Use your ChatGPT plan through the local companion. Each task keeps the account selected when it was created.</p>
                <a href="https://chatgpt.com/settings/usage" target="_blank" rel="noopener noreferrer">ChatGPT usage and app access</a>
                @if (accounts.StorageError != null) { <p role="alert">Account storage could not be updated. Check the companion's storage permissions before continuing.</p> }
                @if (accounts.Accounts.Length > 0)
                {
                    <label>Active account <select value="@accounts.ActiveAccountId" @onchange="ChooseAccountAsync" disabled="@_accountBusy"><option value="" disabled>Select an account</option>@foreach (var account in accounts.Accounts) { <option value="@account.Id">@account.Label · @account.Email · @account.Id[..Math.Min(8, account.Id.Length)] · @(account.SignedIn ? "signed in" : "signed out")</option> }</select></label>
                    @if (ActiveAccount is { } active)
                    {
                        <p>@(active.PlanEnabled ? "ChatGPT plan access granted." : "Sign in and grant ChatGPT plan access to run requests.")</p>
                        <label>Account label <input @bind="_accountLabel" maxlength="100" /></label>
                        <label><input type="checkbox" @bind="_rememberAccount" /> Remember credentials on this computer</label>
                        <button @onclick="ConfigureAccountAsync" disabled="@(_accountBusy || SigningIn)">Save account preferences</button>
                        <button @onclick="() => BeginAccountSignInAsync(true)" disabled="@(_accountBusy || SigningIn)">Continue with ChatGPT</button>
                        @if (active.SignedIn && !active.PlanEnabled) { <button @onclick="() => BeginAccountSignInAsync(true, false, true)" disabled="@(_accountBusy || SigningIn)">Enable ChatGPT plan usage</button> }
                        <button @onclick="SignOutAccountAsync" disabled="@(_accountBusy || !active.SignedIn)">Sign out and stop account tasks</button>
                        @if (active.LastFailure is { } failure)
                        { <details><summary>Last account request error · @failure.Time.ToLocalTime().ToString("T")</summary><p>HTTP @failure.Details.HttpStatus · @failure.Code · @failure.Details.ResponseShape</p><p>Parameter: @(failure.Details.ErrorParameter ?? "—") · Request ID: @(failure.Details.RequestId ?? "—")</p></details> }
                    }
                }
                <details open="@(accounts.Accounts.Length == 0)"><summary>@(accounts.Accounts.Length == 0 ? "Sign in" : "Add another account or workspace")</summary>
                    <label>New account label <input @bind="_newAccountLabel" maxlength="100" placeholder="Optional label" /></label>
                    <label><input type="checkbox" @bind="_rememberNewAccount" /> Remember credentials on this computer</label>
                    <button @onclick="() => BeginAccountSignInAsync(false)" disabled="@(_accountBusy || SigningIn)">Continue with ChatGPT</button>
                </details>
                <p>Registration details stay in the companion. Tokens stay in memory unless remembered in protected local storage.</p>
                @if (accounts.SignIn is { } signIn)
                {
                    <p role="status">@AccountSignInMessage(signIn)</p>
                    @if (signIn.CanRetryRegistration) { <button @onclick="() => BeginAccountSignInAsync(false, true)" disabled="@_accountBusy">Retry registration sign-in</button> }
                    @if (SigningIn)
                    {
                        <p>Sign-in expires at @signIn.ExpiresAt.ToLocalTime().ToString("T").</p>
                        @if (_signInLaunchUrl != null) { <a href="@_signInLaunchUrl" target="_blank" rel="noopener noreferrer">Open ChatGPT sign-in if the window did not open</a> }
                        <button @onclick="CancelAccountSignInAsync" disabled="@_accountBusy">Cancel sign-in</button>
                    }
                }
                @if (_accountMessage != null) { <p role="status">@_accountMessage</p> }
            </details>
        }
        <details class="agent-operations">
            <summary>MCP operations (@(_state.Operations?.Length ?? 0))</summary>
            <p>Background waits expire after two minutes. Cancelling stops a wait immediately.</p>
            <button @onclick='() => CommandAsync("operations_clear", new { })'>Clear finished operations</button>
            @foreach (var operation in _state.Operations ?? [])
            {
                <div class="agent-operation"><code>@operation.TaskId</code> · @operation.Status · @operation.CreatedAt.ToLocalTime().ToString("T")
                    <button disabled='@(operation.Status != "Working")' @onclick='() => CommandAsync("operation_cancel", new { id = operation.TaskId })'>Cancel operation</button>
                </div>
            }
        </details>
        <details class="agent-create" open="@(_state.Tasks.Length == 0)">
            <summary>New task</summary>
            @if (_state.Providers.Length == 0) { <p>Configure a provider key in the companion environment, then restart it.</p> }
            <label>Provider <select aria-label="Provider" @bind="_provider" @bind:after="ProviderChanged">@foreach (var provider in _state.Providers) { <option value="@provider">@ProviderLabel(provider)</option> }</select></label>
            @if (_provider == ChatGptProvider) { <p>New task account: @(ActiveAccount?.Label ?? "Select and sign in to an account above"). Uses ChatGPT plan allowance; account mode never falls back to API-key billing.</p> }
            <label>Model <input @bind="_model" list="agent-models" placeholder="Model ID" /></label>
            <datalist id="agent-models">@foreach (var model in _models) { <option value="@model.Slug">@model.DisplayName</option> }</datalist>
            <button @onclick="DiscoverModelsAsync" disabled="@(string.IsNullOrEmpty(_provider) || !ProviderReady)">Discover models</button>
            <label>Task name <input @bind="_name" maxlength="200" /></label>
            <button @onclick="CreateAsync" disabled="@(string.IsNullOrWhiteSpace(_model) || string.IsNullOrWhiteSpace(_provider) || !ProviderReady || _state.Tasks.Length >= 8)">Create task</button>
        </details>
        @if (_state.Tasks.Length > 0)
        {
            <label>Task <select aria-label="Task" value="@_selectedId" @onchange="SelectTaskAsync">@foreach (var task in _state.Tasks) { <option value="@task.Id">@task.Name · @task.Status</option> }</select></label>
        }
        @if (Selected is { } selected)
        {
            <div class="agent-task-actions">
                <input aria-label="Rename task" @bind="_taskName" maxlength="200" />
                <button @onclick='() => CommandAsync("rename", new { id = selected.Id, text = _taskName })' disabled="@IsRunning(selected)">Rename</button>
                <button @onclick='() => CommandAsync("delete", new { id = selected.Id })' disabled="@IsRunning(selected)">Delete</button>
                <button @onclick="ExportAsync">Export thread</button>
                <button @onclick="CopyThreadAsync">Copy public thread</button><button @onclick="BeginHandoffAsync">New task with context</button>
            </div>
            <p role="status">@selected.Status · @selected.TotalTokens.ToString("N0") tokens · @selected.CheckpointCount checkpoints @selected.StatusReason</p>
            @if (selected.Account is { } taskAccount) { <p>ChatGPT plan account: @taskAccount.Label. Output allowance is an estimate, not a server cap; one response can exceed the remaining task budget.</p> }
            <p>@selected.ReportedTokens.ToString("N0") provider-reported tokens · @selected.EstimatedTokens.ToString("N0") estimated tokens · @((selected.NativeContextBytes / 1024d).ToString("N1")) KiB context</p>
            @if (selected.RetryAfterUtc is { } cooldown && cooldown > DateTimeOffset.UtcNow) { <p>Provider cooldown until @cooldown.ToLocalTime().ToString("T").</p> }
            @if (selected.OutputLimitToExceed is { } outputLimit) { <p>Resume requires an effective output allowance above @outputLimit.ToString("N0") tokens.</p> }
            @if (selected.IsPreviousWorkspace) { <p class="empty">Previous workspace: this task remains available for review and export. Create a new task to work on the current project.</p> }
            <details class="agent-options">
                <summary>Run permissions and limits</summary>
                <p>Settings belong to the selected task. The live project's access policy also applies to every operation.</p>
                <button @onclick="() => SetPreset(false)">Extended limits</button><button @onclick="() => SetPreset(true)">Large limits</button>
                <button @onclick="SaveNumericPreferencesAsync">Save numeric defaults</button><button @onclick="ResetPermissions">Reset task permissions</button>
                <p>Saved defaults contain numeric limits only. New tasks begin with Ask permissions.</p>
                <label>Task permission profile <select aria-label="Task permission profile" @bind="_profile">@foreach (var profile in Profiles) { <option>@profile</option> }</select></label>
                <label><input type="checkbox" @bind="_neverAsk" /> Deny operations that require a review</label>
                @foreach (var scope in Scopes)
                {
                    <label>@scope <select value="@_scopes.GetValueOrDefault(scope, "default")" @onchange="args => ChangeScope(scope, args)"><option>default</option><option>allow</option><option>ask</option><option>deny</option></select></label>
                }
                <label>Exact tool rules (JSON object) <textarea @bind="_toolRules" rows="2" spellcheck="false" placeholder='{"xamlg_runtime_run":"deny"}' /></label>
                <label>Requests per run <input type="number" min="1" max="10000" @bind="_requests" /></label>
                <label>Tool calls per run <input type="number" min="1" max="10000" @bind="_tools" /></label>
                <label>@(selected.Account == null ? "Output tokens per request" : "Output reserve (not a cap)") <input type="number" min="1" max="1000000" @bind="_outputTokens" /></label>
                <label>Task token budget <input type="number" min="1" max="100000000" @bind="_taskTokens" /></label>
                <label>Context bytes <input type="number" min="1024" max="16000000" @bind="_contextBytes" /></label>
                <label>Tool result bytes <input type="number" min="1024" max="8388608" @bind="_toolResultBytes" /></label>
                <label>Automatic retries <input type="number" min="0" max="10" @bind="_retries" /></label>
                <label>Request timeout minutes <input type="number" min="1" max="30" @bind="_timeoutMinutes" /></label>
                <label>Lease minutes <input type="number" min="1" max="60" @bind="_leaseMinutes" /></label>
                <label><input type="checkbox" @bind="_autoCompact" /> Compact context automatically at complete tool boundaries</label>
                <label>Automatic compaction input tokens (0 disables) <input type="number" min="0" max="2000000" @bind="Preferences.Numeric.AutomaticInputTokens" /></label>
                <label>Model context window tokens (0 unspecified) <input type="number" min="0" max="4000000" @bind="Preferences.Numeric.ModelContextWindowTokens" /></label>
                <label>Recent complete turns to retain <input type="number" min="0" max="16" @bind="Preferences.Numeric.RecentCompleteTurns" /></label>
                <label>Checkpoint output tokens <input type="number" min="256" max="8192" @bind="Preferences.Numeric.CheckpointOutputTokens" /></label>
            </details>
            @if (selected.Plan.Length > 0)
            {
                <ol class="agent-plan">@foreach (var step in selected.Plan) { <li><strong>@step.Status</strong> @step.Text</li> }</ol>
            }
            <button @onclick="FollowThreadAsync">Follow latest</button>
            <div class="agent-thread" aria-label="Agent thread" aria-live="polite" data-task-id="@selected.Id" @ref="_threadElement">
                @foreach (var item in selected.Events.Where(e => e.Kind is not "text_delta"))
                {
                    <article @key="item.Sequence" data-sequence="@item.Sequence" class="agent-message agent-@item.Kind"><small>@item.Kind</small><button @onclick="() => CopyTextAsync(item.Text)">Copy</button><pre>@item.Text</pre></article>
                }
                @if (_liveText.Length != 0) { <article class="agent-message"><small>assistant · streaming</small><pre>@_liveText</pre></article> }
            </div>
            @foreach (var pending in _state.Pending.Where(p => p.TaskId == selected.Id))
            {
                <section class="agent-pending" @key="pending.Id" aria-label="Agent request">
                    @if (pending.Kind == "approval")
                    {
                        <h3>Review operation</h3><pre>@pending.Content.GetRawText()</pre>
                        <button @onclick='() => RespondAsync(pending.Id, "deny")'>Deny</button>
                        <button @onclick='() => RespondAsync(pending.Id, "allowOnce")'>Allow once</button>
                        <button @onclick='() => RespondAsync(pending.Id, "allowToolForRun")'>Allow this tool for this run</button>
                    }
                    else
                    {
                        <h3>@pending.Content.GetProperty("question").GetString()</h3>
                        @if (pending.Content.TryGetProperty("options", out var options) && options.ValueKind == System.Text.Json.JsonValueKind.Array)
                        {
                            @foreach (var option in options.EnumerateArray()) { <button @onclick="() => RespondAsync(pending.Id, option.GetString()!)">@option.GetString()</button> }
                        }
                        <label>Answer <input @bind="_answer" maxlength="16384" /></label><button @onclick="() => RespondAsync(pending.Id, _answer)">Send answer</button>
                    }
                </section>
            }
            <label>Message <textarea value="@_draft" @oninput="DraftChangedAsync" rows="4" maxlength="262144" placeholder="Describe the change or investigation" /></label>
            <div class="agent-run-actions">
                <button class="primary" @onclick="RunAsync" disabled="@(selected.IsPreviousWorkspace || AnyRunning || selected.Status is "paused" or "cancelled" or "failed" || string.IsNullOrWhiteSpace(_draft))">Run</button>
                <button @onclick="ResumeAsync" disabled="@(selected.IsPreviousWorkspace || AnyRunning || selected.Status != "paused" || selected.RetryAfterUtc > DateTimeOffset.UtcNow)">Resume</button>
                <button @onclick="QueueDraftAsync" disabled="@(selected.IsPreviousWorkspace || _queueBusy || string.IsNullOrWhiteSpace(_draft) || selected.Status is "cancelled" or "failed")">Queue follow-up</button>
                <button @onclick='() => CommandAsync("stop", new { })' disabled="@(!_state.Tasks.Any(IsRunning))">Stop &amp; revoke</button>
                <button @onclick="ReviewCompaction" disabled="@(selected.IsPreviousWorkspace || AnyRunning)">Compact context</button>
            </div>
            @if (selected.Queue.Messages.Length > 0)
            {
                <details class="agent-queue" open>
                    <summary>@selected.Queue.Messages.Length queued follow-ups</summary>
                    <p>Each message waits here until you select it and confirm a new run.</p>
                    <label>Queued message <select aria-label="Queued message" @key="selected.Queue.Revision" value="@QueueEdit.Id" disabled="@_queueBusy" @onchange='args => SelectQueue(args.Value?.ToString() ?? "")'>
                        @foreach (var message in selected.Queue.Messages) { <option @key="message.Id" value="@message.Id">@(message.Text.Length > 120 ? message.Text[..120] + "…" : message.Text)</option> }
                    </select></label>
                    <label>Edit queued message <textarea @bind="QueueEdit.Text" @bind:event="oninput" maxlength="100000" rows="4" /></label>
                    <button @onclick="SaveQueueAsync" disabled="@(_queueBusy || string.IsNullOrWhiteSpace(QueueEdit.Text))">Save queued edit</button>
                    <button @onclick="() => SelectQueue(QueueEdit.Id)" disabled="@_queueBusy">Reload queued message</button>
                    <button @onclick="() => MoveQueueAsync(-1)" disabled="@(_queueBusy || QueueIndex <= 0)">Move up</button>
                    <button @onclick="() => MoveQueueAsync(1)" disabled="@(_queueBusy || QueueIndex < 0 || QueueIndex >= selected.Queue.Messages.Length - 1)">Move down</button>
                    <button @onclick="RemoveQueueAsync" disabled="@_queueBusy">Remove queued message</button>
                    <button @onclick="ReviewQueuedRun" disabled="@(selected.IsPreviousWorkspace || _queueBusy || AnyRunning || selected.Status is not ("ready" or "completed") || QueueIndex < 0)">Send selected message</button>
                    <button @onclick="ClearQueueAsync" disabled="@_queueBusy">Clear queue</button>
                </details>
            }
            <label>Source comparison <select value="@(_latestRun ? "latest" : "task")" @onchange="ChangeBaseline"><option value="task">Since task start</option><option value="latest">Since latest run</option></select></label>
            @if (SelectedChanges is { Files.Length: > 0 } changes)
            {
                <details class="agent-changes">
                    <summary>Review @changes.Files.Length changed source files</summary>
                    @foreach (var file in changes.Files)
                    {
                        <label><input type="checkbox" checked="@_restorePaths.Contains(file.Path)" @onchange="args => SelectRestore(file.Path, args)" /> @file.Path (@file.BeforeLength → @file.AfterLength characters)</label>
                    }
                    <button @onclick="PreviewChangesAsync">Show before and after</button>
                    <button @onclick="PreviewDiffAsync">Unified diff</button><button @onclick="ExportPatchAsync">Save review patch</button>
                    <button @onclick="ReviewRestore" disabled="@(selected.IsPreviousWorkspace || AnyRunning || _restorePaths.Count == 0)">Restore selected files</button>
                    @foreach (var file in _changePreview)
                    {
                        <details><summary>@file.Path</summary><h4>Before</h4><pre>@SourceExcerpt(file.Before)</pre><h4>After</h4><pre>@SourceExcerpt(file.After)</pre></details>
                    }
                    @foreach (var file in _diffPreview)
                    {
                        <details open><summary>@file.Path</summary>
                            @if (file.Coarse) { <p>Large changed region shown as replacement lines.</p> }
                            @if (file.Truncated) { <p>Display excerpt; the review patch contains the complete captured changes.</p> }
                            <div class="agent-diff">@foreach (var line in file.Lines) { <button class="diff-@line.Kind" @onclick="() => SelectDiffLine(file.Path, line)"><span>@line.BeforeLine</span><span>@line.AfterLine</span><code>@line.Text</code></button> }</div>
                        </details>
                    }
                    <label>Review feedback <textarea @bind="_reviewFeedback" maxlength="8000" rows="3" /></label>
                    @if (_feedbackTarget != null) { <p>A selected diff line is attached to this feedback.</p><button @onclick="() => _feedbackTarget = null">Clear line target</button> }
                    <button @onclick="QueueReviewFeedbackAsync" disabled="@(selected.IsPreviousWorkspace || _queueBusy || string.IsNullOrWhiteSpace(_reviewFeedback))">Queue review feedback</button>
                </details>
            }
        }
    }
    @if (_error != null) { <p class="runtime-error" role="alert">@_error</p> }
    @if (_handoff != null)
    {
        <div class="authoring-backdrop"><section class="authoring-dialog" role="dialog" aria-modal="true" aria-label="Review task context">
            <h2>New task with context</h2><p>Edit this public excerpt, then create a draft for a new task. Run it after reviewing its own permissions.</p>
            <label>New task name <input @bind="_name" maxlength="200" /></label>
            <label>Provider <select @bind="_provider" @bind:after="ProviderChanged">@foreach (var provider in _state.Providers) { <option value="@provider">@ProviderLabel(provider)</option> }</select></label>
            @if (_provider == ChatGptProvider) { <p>ChatGPT account: @(ActiveAccount?.Label ?? "Select and sign in to an account before creating this task").</p> }
            <label>Model <input @bind="_model" /></label>
            <textarea aria-label="Context handoff" @bind="_handoff" maxlength="262144" rows="16" />
            <footer><button @onclick="() => _handoff = null" disabled="@_handoffBusy">Cancel</button><button @onclick="CreateWithContextAsync" disabled="@(_handoffBusy || _state.Tasks.Length >= 8 || !ProviderReady || string.IsNullOrWhiteSpace(_model))">Create with reviewed context</button></footer>
        </section></div>
    }
    @if (_restoreReview is { } restore)
    {
        <div class="authoring-backdrop"><section class="authoring-dialog" role="dialog" aria-modal="true" aria-label="Review source restore">
            <h2>Restore selected source</h2><p>Restore these files to the @(restore.LatestRun ? "latest-run" : "task-start") checkpoint at reviewed revision @restore.Revision. This comparison includes manual edits made during the task. Restoration creates a normal project undo step.</p>
            <ul>@foreach (var path in restore.Paths) { <li>@path</li> }</ul>
            <footer><button @onclick="() => _restoreReview = null">Cancel</button><button @onclick="ConfirmRestoreAsync">Confirm source restore</button></footer>
            @if (_error != null) { <p role="alert">@_error</p> }
        </section></div>
    }
    @if (_runReview is { } review)
    {
        <div class="authoring-backdrop" @onkeydown='args => { if (args.Key == "Escape") CancelRunReview(); }' @onkeydown:stopPropagation="true">
            <section class="authoring-dialog" role="dialog" aria-modal="true" aria-label="Review agent run">
                <header><h2>@(review.Compact ? "Review context compaction" : "Review agent run")</h2></header>
                <p><strong>@review.Name</strong> · @review.Provider · @review.Model</p>
                <p>This run uses the current live project. Permission profile: <strong>@review.Profile</strong>.</p>
                <p>@review.Limits</p>
                <details><summary>Scope and exact tool rules</summary><pre>@review.Options.GetProperty("policy").GetRawText()</pre></details>
                <pre class="agent-run-preview">@(review.Preview ?? "Resume the pending turn with its completed tool results.")</pre>
                @if (review.Profile == "fullAccess")
                {
                    <label><input type="checkbox" @bind="_fullAccessAcknowledged" /> Allow Full Access for this run, including runtime execution permitted by the live project</label>
                }
                <footer>
                    <button @onclick="CancelRunReview" disabled="@_reviewBusy" @ref="_runReviewCancel">Cancel</button>
                    <button class="primary" @onclick="ConfirmRunAsync" disabled="@(_reviewBusy || (review.Profile == "fullAccess" && !_fullAccessAcknowledged))">@(review.Compact ? "Confirm compaction" : "Confirm run")</button>
                </footer>
                @if (_error != null) { <p class="runtime-error" role="alert">@_error</p> }
            </section>
        </div>
    }
</section>
