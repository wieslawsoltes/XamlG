<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>XamlG.XamlX.TestReference</AssemblyName>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS0618;CS0612;CS8632</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../external/XamlX/src/XamlX/**/*.cs" Exclude="../../external/XamlX/src/XamlX/**/obj/**/*.cs;../../external/XamlX/src/XamlX/**/bin/**/*.cs" LinkBase="Upstream/XamlX" />
    <Compile Include="../../external/XamlX/src/XamlX.Runtime/**/*.cs" Exclude="../../external/XamlX/src/XamlX.Runtime/**/obj/**/*.cs;../../external/XamlX/src/XamlX.Runtime/**/bin/**/*.cs" LinkBase="Upstream/Runtime" />
  </ItemGroup>
  <Target Name="ValidateUpstreamCheckout" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('../../external/XamlX/src/XamlX/XamlLoadException.cs')" Text="Checkout the pinned AvaloniaUI/XamlX revision into external/XamlX before building the optional upstream suites. See tests/Upstream.props." />
  </Target>
</Project>
