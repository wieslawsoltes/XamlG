<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <XamlGPackageVersion Condition="'$(XamlGPackageVersion)' == ''">0.1.0-alpha.1</XamlGPackageVersion>
    <XamlGFramework>Avalonia</XamlGFramework>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>obj/generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="XamlG.Generator" Version="$(XamlGPackageVersion)" PrivateAssets="all" />
    <PackageReference Include="XamlG.AvaloniaRuntime" Version="$(XamlGPackageVersion)" />
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Simple" Version="12.1.3" />
  </ItemGroup>
</Project>
