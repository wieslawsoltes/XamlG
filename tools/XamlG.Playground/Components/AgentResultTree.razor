@using System.Text.Json

@if (Value.ValueKind is JsonValueKind.Object or JsonValueKind.Array)
{
    <dl class="agent-result-fields">
    @foreach (var field in Fields.Take(12))
    {
        <div class="agent-result-field">
        @if (field.Key is "$moreItems" or "$moreFields") { <dd class="agent-help">@(field.Value.ValueKind == JsonValueKind.Object ? field.Value.GetProperty(field.Key).ToString() : field.Value.ToString()) more entries in the full result</dd> }
        else if (field.Value.ValueKind is JsonValueKind.Object or JsonValueKind.Array)
        {
            <dd><details class="agent-result-branch"><summary>@AgentEventCard.Humanize(field.Key)<span>@Description(field.Value)</span></summary>
            @if (Depth < 4) { <AgentResultTree Value="field.Value" Depth="@(Depth + 1)" /> }
            else { <p class="agent-help">Open raw data for deeper values.</p> }
            </details></dd>
        }
        else
        {
            <dt>@AgentEventCard.Humanize(field.Key)</dt><dd>@Display(field.Value)</dd>
        }
        </div>
    }
    @if (Fields.Count() > 12) { <div><dd class="agent-help">@(Fields.Count() - 12) more entries in raw data</dd></div> }
    </dl>
}
else { <p>@Display(Value)</p> }

@code {
    [Parameter] public JsonElement Value { get; set; }
    [Parameter] public int Depth { get; set; }
    private IEnumerable<KeyValuePair<string, JsonElement>> Fields => Value.ValueKind == JsonValueKind.Object
        ? Value.EnumerateObject().Select(property => new KeyValuePair<string, JsonElement>(property.Name, property.Value))
        : Value.EnumerateArray().Select((value, index) => new KeyValuePair<string, JsonElement>(Label(value, index), value));
    private static string Label(JsonElement value, int index)
    {
        if (value.ValueKind == JsonValueKind.Object)
        {
            if (value.EnumerateObject().Count() == 1 && value.TryGetProperty("$moreItems", out _)) return "$moreItems";
            foreach (var name in new[] { "name", "path", "type", "text", "key" })
                if (value.TryGetProperty(name, out var field) && field.ValueKind == JsonValueKind.String && !string.IsNullOrEmpty(field.GetString())) return Display(field);
        }
        return $"Item {index + 1}";
    }
    private static string Description(JsonElement value) => value.ValueKind == JsonValueKind.Array ? $"{value.GetArrayLength()} items" : $"{value.EnumerateObject().Count()} fields";
    private static string Display(JsonElement value)
    {
        var text = value.ValueKind == JsonValueKind.Null ? "—" : value.ToString();
        return text.Length > 180 ? text[..180] + "…" : text;
    }
}
