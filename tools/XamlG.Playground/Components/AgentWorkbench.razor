@using System.Text.Json
@implements IAsyncDisposable
@inject IJSRuntime JavaScript

<section class="agent-workbench @(_expanded ? "is-expanded" : "")" aria-label="Coding agent workbench">
    <div class="agent-shell">
    <header class="agent-heading">
        <span class="agent-avatar"><AgentIcon Name="Agent" /></span>
        <div class="agent-heading-title"><h2>Coding agent</h2><button class="agent-connection-shortcut" @onclick='() => SelectSectionAsync("Connection")' aria-label="Open agent connection"><span class="agent-connection-dot @(_connected && ProviderReady ? "is-ready" : "")"></span>@ConnectionLabel</button></div>
        <span class="tab-spacer"></span>
        @if (AnyRunning) { <button class="agent-stop" @onclick='() => CommandAsync("stop", new { })'>Stop</button> }
        <button class="agent-icon-button" @onclick="RefreshAsync" disabled="@_refreshing" aria-label="Refresh coding agent" title="Refresh coding agent"><AgentIcon Name="Refresh" /></button>
        <button class="agent-icon-button" @onclick="() => _expanded = !_expanded" aria-label="@(_expanded ? "Return to dock" : "Expand agent workspace")" title="@(_expanded ? "Return to dock" : "Expand agent workspace")"><AgentIcon Name="@(_expanded ? "Collapse" : "Expand")" /></button>
    </header>
    <nav class="agent-navigation" aria-label="Agent sections">
        @foreach (var section in Sections)
        {
            <button aria-label="@section" title="@section" aria-pressed='@(PaneVisible(section) ? "true" : "false")' @onclick="() => SelectSectionAsync(section)"><AgentIcon Name="@section" /><span class="agent-navigation-label">@(section == "Tasks" ? "Threads" : section)</span>@if (SectionCount(section) is > 0 and var count) { <span class="agent-count" aria-hidden="true">@count</span> }</button>
        }
        <div class="agent-sidebar-threads">
            <div class="agent-sidebar-caption">Threads <button class="agent-icon-button" aria-label="Create thread" @onclick='() => SelectSectionAsync("Tasks")'><AgentIcon Name="Plus" /></button></div>
            @foreach (var thread in _state.Tasks)
            {
                <button class="agent-sidebar-thread" aria-current="@(thread.Id == _selectedId ? "page" : null)" @onclick="() => SelectThreadAsync(thread.Id)"><span class="agent-thread-dot" data-status="@thread.Status"></span><span>@thread.Name</span>@if (thread.Queue.Messages.Length > 0) { <small>@thread.Queue.Messages.Length</small> }</button>
            }
            @if (_state.Tasks.Length == 0) { <p>Your conversations will appear here.</p> }
        </div>
    </nav>
    @if (_connected && _state.Tasks.Length > 0)
    {
        <div class="agent-task-context">
            <div class="agent-task-picker"><select aria-label="Task" value="@_selectedId" @onchange="SelectTaskAsync">@foreach (var task in _state.Tasks) { <option value="@task.Id">@task.Name</option> }</select><button class="agent-icon-button" aria-label="New task" title="New task" @onclick='() => SelectSectionAsync("Tasks")'><AgentIcon Name="Plus" /></button></div>
            @if (Selected is { } contextTask)
            {
                <details class="agent-task-status"><summary title="Task status and usage" aria-label="Task status and usage"><span class="agent-status" data-status="@contextTask.Status">@contextTask.Status</span></summary>
                    <div class="agent-task-details">
                    <p role="status">@contextTask.StatusReason</p>
                    <p class="agent-context-model">@contextTask.ProviderId · @contextTask.Model</p>
                    <p>@contextTask.TotalTokens.ToString("N0") tokens · @contextTask.CheckpointCount checkpoints</p>
                    <dl class="agent-metrics"><div><dt>Reported tokens</dt><dd>@contextTask.ReportedTokens.ToString("N0")</dd></div><div><dt>Estimated tokens</dt><dd>@contextTask.EstimatedTokens.ToString("N0")</dd></div><div><dt>Context</dt><dd>@((contextTask.NativeContextBytes / 1024d).ToString("N1")) KiB</dd></div></dl>
                    @if (contextTask.Account is { } taskAccount) { <p>ChatGPT plan account: @taskAccount.Label. Output allowance is an estimate, not a server cap; one response can exceed the remaining task budget.</p> }
                    @if (contextTask.RetryAfterUtc is { } cooldown && cooldown > DateTimeOffset.UtcNow) { <p>Provider cooldown until @cooldown.ToLocalTime().ToString("T").</p> }
                    @if (contextTask.OutputLimitToExceed is { } outputLimit) { <p>Resume requires an effective output allowance above @outputLimit.ToString("N0") tokens.</p> }
                    @if (contextTask.IsPreviousWorkspace) { <p class="agent-notice">Previous workspace: this task remains available for review and export. Create a new task to work on the current project.</p> }
                    </div>
                </details>
            }
        </div>
    }
    <div class="agent-content @(PaneVisible("Conversation") && Selected != null ? "is-conversation" : "")" @ref="_contentElement">
    <section class="agent-section agent-section-connection" hidden="@(!PaneVisible("Connection"))" aria-label="Agent connection settings">
    <div class="agent-section-heading"><div><h3>Connect your agent</h3><p>Choose where it runs and how to sign in.</p></div><AgentIcon Name="Connection" /></div>
    @if (UiStore != null)
    {
        <details class="intelligent-ui-demo"><summary>Intelligent UI</summary>
            <p>Reactive Avalonia XAML and C# expressions. This example runs locally and needs no provider key.</p>
            <button @onclick="ShowIntelligentUiDemo" disabled="@(!UiReady)">Try intelligent UI</button>
            @if (_uiDemo != null)
            { <IntelligentUiCard Store="UiStore" Presentation="_uiDemo" Ready="UiReady" MessageRequested="UseUiMessageAsync" ToolRequested="UiToolRequested" Tools="UiTools" /> }
        </details>
    }
    <div class="agent-card">
    <label>Agent connection <select aria-label="Agent connection" value="@_connectionMode" @onchange="ConnectionChangedAsync" disabled="@(AnyRunning || _modelsBusy || _runReview != null)">
        <option value="direct">Direct API · run in this browser</option><option value="relay">Local provider relay · API keys stay local</option><option value="companion">Paired companion · server and account agents</option>
    </select></label>
    <p class="agent-help">@(IsDirect ? "No companion required. Requests go directly to your provider." : IsBrowser ? "Run in Studio using provider keys stored in your local companion." : "Run agents in the companion, with API keys or your ChatGPT account.")</p>
    @if (!IsBrowser)
    {
        <div class="agent-inline-actions"><span class="agent-status">@(_connected ? "Companion connected" : "Companion not connected")</span><button @onclick="() => AccessRequested.InvokeAsync()">Open Agent access</button></div>
    }
    </div>
    <div class="agent-card">
        <h4>Provider access</h4>
        @if (_storageError != null) { <p class="agent-notice" role="alert">@_storageError</p> }
        <label>Provider <select disabled="@(AnyRunning || _modelsBusy)" aria-label="Provider" @bind="_provider" @bind:after="ProviderChanged">@foreach (var provider in _state.Providers) { <option value="@provider">@ProviderLabel(provider)</option> }</select></label>
        @if (_provider == ChatGptProvider) { <p>New task account: @(ActiveAccount?.Label ?? "Select and sign in to an account below"). Uses ChatGPT plan allowance; account mode never falls back to API-key billing.</p> }
    @if (IsDirect)
    {
        <section class="agent-direct-connection" aria-label="Direct API connection">
            <label>API key <input placeholder="Paste your provider API key" type="password" aria-label="API key" autocomplete="off" spellcheck="false" maxlength="4096" @bind="_apiKey" @bind:event="oninput" disabled="@(AnyRunning || _modelsBusy)" /></label>
            <label><input type="checkbox" @bind="_acceptBrowserExposure" disabled="@(AnyRunning || _modelsBusy)" /> Accept browser key exposure</label>
            <p class="agent-help">Connections and keys are remembered in this browser by default. Page code and browser extensions can access them. Direct requests depend on provider CORS support.</p>
            <button @onclick="ForgetConnectionAsync">Forget connection</button>
        </section>
    }
    @if (_connectionMode == "relay")
    {
        <section class="agent-direct-connection" aria-label="Local provider relay">
            <p>The companion relays provider requests using its configured API keys. Your task and IDE permissions run in this browser, independently of external MCP access.</p>
            <label>Relay origin <input aria-label="Relay origin" @bind="_relayUrl" disabled="@(AnyRunning || _modelsBusy)" /></label>
            <label>Relay Owner token <input aria-label="Relay Owner token" type="password" autocomplete="off" spellcheck="false" @bind="_relayToken" @bind:event="oninput" disabled="@(AnyRunning || _modelsBusy)" /></label>
            <button @onclick="ForgetConnectionAsync">Forget connection</button>
            <p class="muted">The Owner token is remembered in this browser and can spend the relay's configured API quota.</p>
        </section>
    }
        @if (_state.ChatGptError != null) { <p role="status">@_state.ChatGptError</p> }
        @if (_state.ChatGpt is { } accounts)
        {
            <details class="agent-accounts" open="@(_provider == ChatGptProvider && ActiveAccount is not { SignedIn: true, PlanEnabled: true })"><summary>ChatGPT accounts</summary>
                <p>Use your ChatGPT plan through the local companion. Each task keeps the account selected when it was created.</p>
                <a href="https://chatgpt.com/settings/usage" target="_blank" rel="noopener noreferrer">ChatGPT usage and app access</a>
                @if (accounts.StorageError != null) { <p role="alert">Account storage could not be updated. Check the companion's storage permissions before continuing.</p> }
                @if (accounts.Accounts.Length > 0)
                {
                    <label>Active account <select value="@accounts.ActiveAccountId" @onchange="ChooseAccountAsync" disabled="@_accountBusy"><option value="" disabled>Select an account</option>@foreach (var account in accounts.Accounts) { <option value="@account.Id">@account.Label · @account.Email · @account.Id[..Math.Min(8, account.Id.Length)] · @(account.SignedIn ? "signed in" : "signed out")</option> }</select></label>
                    @if (ActiveAccount is { } active)
                    {
                        <p>@(active.PlanEnabled ? "ChatGPT plan access granted." : "Sign in and grant ChatGPT plan access to run requests.")</p>
                        <label>Account label <input @bind="_accountLabel" maxlength="100" /></label>
                        <label><input type="checkbox" @bind="_rememberAccount" /> Remember credentials on this computer</label>
                        <button @onclick="ConfigureAccountAsync" disabled="@(_accountBusy || SigningIn)">Save account preferences</button>
                        <button @onclick="() => BeginAccountSignInAsync(true)" disabled="@(_accountBusy || SigningIn)">Continue with ChatGPT</button>
                        @if (active.SignedIn && !active.PlanEnabled) { <button @onclick="() => BeginAccountSignInAsync(true, false, true)" disabled="@(_accountBusy || SigningIn)">Enable ChatGPT plan usage</button> }
                        <button @onclick="SignOutAccountAsync" disabled="@(_accountBusy || !active.SignedIn)">Sign out and stop account tasks</button>
                        @if (active.LastFailure is { } failure)
                        { <details><summary>Last account request error · @failure.Time.ToLocalTime().ToString("T")</summary><p>HTTP @failure.Details.HttpStatus · @failure.Code · @failure.Details.ResponseShape</p><p>Parameter: @(failure.Details.ErrorParameter ?? "—") · Request ID: @(failure.Details.RequestId ?? "—")</p></details> }
                    }
                }
                <details open="@(accounts.Accounts.Length == 0)"><summary>@(accounts.Accounts.Length == 0 ? "Sign in" : "Add another account or workspace")</summary>
                    <label>New account label <input @bind="_newAccountLabel" maxlength="100" placeholder="Optional label" /></label>
                    <label><input type="checkbox" @bind="_rememberNewAccount" /> Remember credentials on this computer</label>
                    <button @onclick="() => BeginAccountSignInAsync(false)" disabled="@(_accountBusy || SigningIn)">Continue with ChatGPT</button>
                </details>
                <p>Registration details stay in the companion. Tokens stay in memory unless remembered in protected local storage.</p>
                @if (accounts.SignIn is { } signIn)
                {
                    <p role="status">@AccountSignInMessage(signIn)</p>
                    @if (signIn.CanRetryRegistration) { <button @onclick="() => BeginAccountSignInAsync(false, true)" disabled="@_accountBusy">Retry registration sign-in</button> }
                    @if (SigningIn)
                    {
                        <p>Sign-in expires at @signIn.ExpiresAt.ToLocalTime().ToString("T").</p>
                        @if (_signInLaunchUrl != null) { <a href="@_signInLaunchUrl" target="_blank" rel="noopener noreferrer">Open ChatGPT sign-in if the window did not open</a> }
                        <button @onclick="CancelAccountSignInAsync" disabled="@_accountBusy">Cancel sign-in</button>
                    }
                }
                @if (_accountMessage != null) { <p role="status">@_accountMessage</p> }
            </details>
        }
    </div>
    <div class="agent-card">
        <div class="agent-section-heading"><h4>Model</h4><span class="agent-status">@(_modelsBusy ? "Loading models…" : _models.Length > 0 ? $"{_models.Length} available" : "Choose a model")</span></div>
        <label>Model <input @bind="_model" @bind:event="oninput" list="agent-models" placeholder="Enter or discover a model ID" /></label>
        <datalist id="agent-models">@foreach (var model in _models) { <option value="@model.Slug">@model.DisplayName</option> }</datalist>
        <div class="agent-inline-actions"><button @onclick="DiscoverModelsAsync" disabled="@(AnyRunning || _modelsBusy || string.IsNullOrEmpty(_provider) || !ProviderReady)">Discover models</button><span class="agent-help">@(ProviderReady ? "Or enter a model ID above." : "Complete provider access to discover models.")</span></div>
    </div>
    <div class="agent-panel-footer"><button class="primary" @onclick='() => SelectSectionAsync("Tasks")' disabled="@(!_connected || !ProviderReady || string.IsNullOrWhiteSpace(_model))">Continue to tasks <AgentIcon Name="Arrow" /></button></div>
    </section>
    @if (!_connected && !PaneVisible("Connection"))
    { <div class="agent-empty"><h3>Connect your coding agent</h3><p>Use a provider API key in this browser, or a local companion.</p><button class="primary" @onclick='() => SelectSectionAsync("Connection")'>Open connection</button></div> }
    @if (_connected)
    {
        <section class="agent-section agent-section-tasks" hidden="@(!PaneVisible("Tasks"))" aria-label="Agent tasks">
        <div class="agent-section-heading"><div><h3>Your tasks</h3><p>Separate conversations, plans, and permissions.</p></div><span class="agent-status">@_state.Tasks.Length / 8</span></div>
        @if (_state.Tasks.Length > 0)
        {
            <div class="agent-task-list" aria-label="Task list">
                @foreach (var task in _state.Tasks)
                {
                    <button class="agent-task-card" aria-pressed='@(task.Id == _selectedId ? "true" : "false")' @onclick="() => Select(task.Id)"><AgentIcon Name="Conversation" /><span><strong>@task.Name</strong><small>@task.ProviderId · @task.Model</small></span><span class="agent-status" data-status="@task.Status">@task.Status</span></button>
                }
            </div>
        }
        <details class="agent-create agent-card" open>
            <summary>New task</summary>
            @if (_state.Providers.Length == 0) { <p>Configure a provider key in the companion environment, then restart it.</p> }
            <div class="agent-inline-actions"><p>@ProviderLabel(_provider) · @(_model.Length == 0 ? "Choose a model in Connection" : _model)</p><button @onclick='() => SelectSectionAsync("Connection")'>Choose provider and model</button></div>
            <label>Task name <input @bind="_name" maxlength="200" /></label>
            <button class="primary" @onclick="CreateAsync" disabled="@(string.IsNullOrWhiteSpace(_model) || string.IsNullOrWhiteSpace(_provider) || !ProviderReady || _state.Tasks.Length >= 8)"><AgentIcon Name="Plus" /> Create task</button>
            @if (_state.Tasks.Length >= 8) { <p class="agent-help">All eight task slots are in use. Export and delete a finished task to make room.</p> }
        </details>
        @if (Selected is { } managedTask) {
            <div class="agent-card"><h4>Manage selected task</h4>
                <label>Rename task <input aria-label="Rename task" @bind="_taskName" maxlength="200" /></label>
                <div class="agent-task-actions">
                <button @onclick='() => CommandAsync("rename", new { id = managedTask.Id, text = _taskName })' disabled="@IsRunning(managedTask)">Rename</button>
                <button class="agent-danger" @onclick='() => _deleteTaskId = managedTask.Id' disabled="@IsRunning(managedTask)">Delete</button>
                </div><h4>Keep or share context</h4><div class="agent-task-actions">
                <button @onclick="ExportAsync">Export thread</button>
                <button @onclick="CopyThreadAsync">Copy public thread</button><button @onclick="BeginHandoffAsync">New task with context</button>
                </div>
            </div>
        }
        </section>
        @if (Selected is { } selected)
        {
            @if (_state.Pending.Any(pending => pending.TaskId == selected.Id) && !PaneVisible("Conversation"))
            { <button class="agent-pending-notice" @onclick='() => SelectSectionAsync("Conversation")'>Your response is needed · open conversation</button> }
            <section class="agent-section agent-section-conversation" hidden="@(!PaneVisible("Conversation"))" aria-label="Agent conversation">
            <div class="agent-conversation-body">
            @if (ThreadHasEarlier || Thread.Page != null)
            {
                <div class="agent-thread-toolbar"><button @onclick="() => PageThreadAsync(true)" disabled="@(Thread.Busy || !ThreadHasEarlier)">Earlier messages</button><button @onclick="() => PageThreadAsync(false)" disabled="@(Thread.Busy || !ThreadHasLater)">Newer messages</button><button @onclick="FollowThreadAsync">Follow latest</button></div>
            }
            @if (Thread.Page != null) { <p role="status">Reading an earlier page. Follow latest returns to the current response.</p> }
            <div class="agent-thread" role="log" tabindex="0" aria-label="Agent thread" aria-live="off" data-task-id="@selected.Id" @ref="_threadElement">
                @if (!VisibleEvents.Any() && VisibleLiveText.Length == 0)
                {
                    <div class="agent-empty agent-thread-empty"><span class="agent-welcome-mark"><AgentIcon Name="Agent" /></span><h3>Let’s build something.</h3><p>Start with an idea, a question, or a change to your project.</p><div class="agent-starters"><button @onclick='() => UseStarter("Explain the structure of this project and where I should start.")'><AgentIcon Name="Tools" />Explore this project</button><button @onclick='() => UseStarter("/plan Improve the current view’s layout and keyboard navigation.")'><AgentIcon Name="Plan" />Plan a change</button><button @onclick='() => UseStarter("Inspect the current diagnostics and fix the underlying issue.")'><AgentIcon Name="Changes" />Fix an issue</button></div></div>
                }
                @foreach (var entry in VisibleThread)
                {
                    var item = entry.Item;
                    @if (item.Kind is "user" or "assistant" or "assistant_incomplete" or "question" or "answer")
                    {
                        <article @key="item.Sequence" data-sequence="@item.Sequence" data-event-sequences="@entry.Sequences" class="agent-message agent-@item.Kind"><div class="agent-message-heading"><small>@(item.Kind == "assistant_incomplete" ? "assistant · incomplete" : item.Kind == "user" ? "You" : item.Kind == "assistant" ? "Agent" : item.Kind)</small><button @onclick="() => CopyTextAsync(item.Text)">Copy</button></div>
                            <AgentMarkdown Text="@item.Text" CopyRequested="CopyTextAsync" />
                        </article>
                    }
                    else
                    {
                        var result = entry.Result ?? item;
                        @if (UiStore != null && XamlG.IntelligentUI.UiPresentation.TryRead(result.Text, out var presentation))
                        { <IntelligentUiCard @key="item.Sequence" Store="UiStore" Presentation="presentation!" Ready="UiReady" MessageRequested="UseUiMessageAsync" ToolRequested="UiToolRequested" Tools="UiTools" /> }
                        else
                        {
                        <AgentEventCard @key="item.Sequence" Sequence="item.Sequence" Sequences="@entry.Sequences" Kind="@result.Kind" Text="@result.Text" ResultPreview="result.ResultPreview" Images="result.Images" ToolName="@(item.ToolName ?? (item.Kind == "tool_started" ? item.Text : result.ToolName))" Running="@IsRunning(selected)" CopyRequested="CopyTextAsync" />
                        }
                    }
                }
                @if (VisibleLiveText.Length != 0) { <article class="agent-message"><small>@(Thread.Page == null ? "assistant · streaming" : "assistant · captured partial reply")</small><pre>@VisibleLiveText</pre></article> }
            </div>
            <div class="agent-pending-list">
            @foreach (var pending in _state.Pending.Where(p => p.TaskId == selected.Id))
            {
                <section class="agent-pending" @key="pending.Id" aria-label="Agent request">
                    @if (pending.Kind == "approval")
                    {
                        <h3>Review @pending.Content.GetProperty("tool").GetProperty("name").GetString()</h3>
                        <p>@pending.Content.GetProperty("tool").GetProperty("description").GetString()</p>
                        <details><summary>Operation arguments</summary><pre>@pending.Content.GetProperty("arguments").GetRawText()</pre></details>
                        @if (pending.Content.TryGetProperty("preview", out var operationPreview) && operationPreview.ValueKind == JsonValueKind.Object)
                        {
                            <p>@operationPreview.GetProperty("note").GetString()</p>
                            @if (operationPreview.GetProperty("truncated").GetBoolean()) { <p>Display excerpt. Save the full review to inspect all source changes.</p> }
                            @foreach (var file in operationPreview.GetProperty("files").EnumerateArray())
                            { <details class="agent-approval-file"><summary>@file.GetProperty("path").GetString()</summary><h4>Before</h4><pre>@file.GetProperty("before").GetString()</pre><h4>After</h4><pre>@file.GetProperty("after").GetString()</pre></details> }
                        }
                        <button @onclick="() => ExportPendingReviewAsync(pending.Id)">Save full review</button>
                        <button @onclick='() => RespondAsync(pending.Id, "deny")'>Deny</button>
                        <button @onclick='() => RespondAsync(pending.Id, "allowOnce")'>Allow once</button>
                        <button disabled="@(!_state.Constraints.AllowRunApprovals)" @onclick='() => RespondAsync(pending.Id, "allowToolForRun")'>Allow this tool for this run</button>
                    }
                    else
                    {
                        <h3>@pending.Content.GetProperty("question").GetString()</h3>
                        @if (pending.Content.TryGetProperty("options", out var options) && options.ValueKind == System.Text.Json.JsonValueKind.Array)
                        {
                            @foreach (var option in options.EnumerateArray()) { <button @onclick="() => RespondAsync(pending.Id, option.GetString()!)">@option.GetString()</button> }
                        }
                        <label>Answer <input @bind="_answer" maxlength="16384" /></label><button @onclick="() => RespondAsync(pending.Id, _answer)">Send answer</button>
                    }
                    <button @onclick='() => CommandAsync("stop", new { })'>Cancel request and stop</button>
                </section>
            }
            </div>
            @if (selected.ProposedPlan is { Accepted: false } proposal)
            {
                <div class="agent-plan-ready"><AgentIcon Name="Plan" /><span><strong>Plan ready</strong><small>Review the approach before implementation.</small></span><button @onclick='() => SelectSectionAsync("Plan")'>View plan</button><button class="primary" @onclick="ImplementPlan" disabled="@AnyRunning">Implement plan</button></div>
            }
            @if (selected.ActiveGoal is { } goal)
            {
                <details class="agent-goal-card"><summary><AgentIcon Name="Goal" /><span>@goal.Objective</span><span class="agent-status" data-status="@goal.Status">@goal.Status</span></summary>
                    <p>@goal.Evidence</p><p class="agent-help">@goal.TokensUsed.ToString("N0") tokens@(goal.TokenBudget is { } budget ? $" / {budget:N0}" : "") · @goal.Continuations continuations</p>
                    @if (goal.Status == "active") { <button @onclick='() => CommandAsync("goal_pause", new { id = selected.Id })'>Pause goal</button> }
                    else if (goal.Status != "complete")
                    {
                        @if (goal.Status == "budgetLimited") { <label>New goal token budget <input type="number" min="1" @bind="_goalBudget" /></label> }
                        <button @onclick="ResumeGoalAsync" disabled="@AnyRunning">Resume goal</button>
                    }
                    <button @onclick='() => CommandAsync("goal_clear", new { id = selected.Id })'>Clear goal</button>
                </details>
            }
            @if (selected.Queue.Messages.Length > 0)
            {
                <div class="agent-inline-queue" aria-label="Queued messages">
                    <button class="agent-queue-heading" @onclick='() => SelectSectionAsync("Queue")'><AgentIcon Name="Queue" />@selected.Queue.Messages.Length queued<span>Manage</span></button>
                    @foreach (var message in selected.Queue.Messages.Take(3))
                    {
                        <div class="agent-queued-message" @key="message.Id"><small>@(message.Delivery == "steer" ? "Steering" : "Next")</small><span>@message.Text</span><button class="agent-icon-button" aria-label="Remove queued message" @onclick='() => ChangeQueueAsync("queue_remove", new { id = selected.Id, messageId = message.Id, expectedRevision = selected.Queue.Revision })'><AgentIcon Name="Close" /></button></div>
                    }
                </div>
            }
            @if (selected.Status == "paused")
            { <div class="agent-resume-banner" role="status"><span>@selected.StatusReason</span><button @onclick="ResumeAsync" disabled="@(selected.IsPreviousWorkspace || AnyRunning || selected.RetryAfterUtc > DateTimeOffset.UtcNow)">Resume</button></div> }
            @if (IsRunning(selected)) { <div class="agent-working" role="status"><span class="agent-working-dot"></span>@(selected.Status == "awaitingAnswer" ? "Waiting for your answer" : selected.Status == "awaitingApproval" ? "Waiting for approval" : selected.Mode == "plan" ? "Planning" : "Working")<span>Follow-ups are queued for the next turn.</span></div> }
            </div>
            <div class="agent-composer" data-mode="@selected.Mode">
            <label><textarea aria-label="Message" title="Enter to send · Shift+Enter for a new line" @ref="_composerElement" data-task-id="@selected.Id" data-can-submit="@(CanSend ? "true" : "false")" data-can-stop="@(IsRunning(selected) ? "true" : "false")" value="@_draft" @oninput="DraftChangedAsync" rows="2" maxlength="100000" placeholder="@ComposerPlaceholder" /></label>
            <div class="agent-composer-toolbar">
                <details class="agent-composer-more"><summary aria-label="More composer actions" title="More actions"><AgentIcon Name="Plus" /></summary><div>
                    <button @onclick="RunAsync" disabled="@(!CanRun)">Run</button>
                    <button aria-label="Queue follow-up" @onclick="QueueDraftAsync" disabled="@(selected.IsPreviousWorkspace || _queueBusy || string.IsNullOrWhiteSpace(_draft))"><AgentIcon Name="Queue" />Queue follow-up</button>
                    <button @onclick="OpenGoalEditor" disabled="@(AnyRunning || selected.ActiveGoal is { Status: not "complete" })"><AgentIcon Name="Goal" />Set a goal</button>
                    <button aria-label="Compact context" @onclick="ReviewCompaction" disabled="@(selected.IsPreviousWorkspace || AnyRunning)"><AgentIcon Name="Compact" />Compact context</button>
                </div></details>
                <select class="agent-mode-picker" aria-label="Collaboration mode" value="@selected.Mode" @onchange="ChangeModeAsync" disabled="@(AnyRunning || _sending)"><option value="default">Code</option><option value="plan">Plan</option></select>
                <button class="agent-model-chip" title="@selected.Model" @onclick='() => SelectSectionAsync("Connection")'>@selected.Model</button>
                <span class="tab-spacer"></span>
                @if (IsRunning(selected))
                {
                    @if (!string.IsNullOrWhiteSpace(_draft)) { <button class="agent-steer-button" @onclick="() => SendDraftAsync(true)" disabled="@(!CanSend)" title="Apply this guidance at the next safe tool boundary">Steer now</button> }
                    <button class="agent-icon-button agent-stop-button" aria-label="Stop &amp; revoke" title="Stop and keep progress" @onclick='() => CommandAsync("stop", new { })'><AgentIcon Name="Stop" /></button>
                }
                <button class="primary agent-send-button" aria-label="@(IsRunning(selected) ? "Queue message" : "Send message")" title="@(IsRunning(selected) ? "Queue for the next turn" : "Send message")" @onclick="() => SendDraftAsync()" disabled="@(!CanSend)"><AgentIcon Name="@(IsRunning(selected) ? "Queue" : "Send")" /></button>
            </div>
            @if (!ProviderReady) { <button class="agent-composer-notice" @onclick='() => SelectSectionAsync("Connection")'>Connect a provider to start <AgentIcon Name="Arrow" /></button> }
            </div>
            <div class="agent-composer-footer"><button @onclick='() => SelectSectionAsync("Permissions")'><AgentIcon Name="Permissions" />@(_profile switch { "autoEdit" => "Auto edit", "fullAccess" => "Full access", "readOnly" => "Read only", "custom" => "Custom permissions", "plan" => "Plan permissions", _ => "Ask before changes" })</button><span>Enter to send · ⇧ Enter for a new line</span></div>
            </section>
            <section class="agent-section agent-section-permissions" hidden="@(!PaneVisible("Permissions"))" aria-label="Agent permissions">
            <div class="agent-section-heading"><div><h3>Permissions &amp; limits</h3><p>Control what this task can do and spend.</p></div><AgentIcon Name="Permissions" /></div>
            <div class="agent-card"><h4>Sending</h4><label><input type="checkbox" @bind="Preferences.ReviewBeforeSend" /> Review every run before sending</label><label><input type="checkbox" @bind="Preferences.ContinueQueue" /> Automatically send queued follow-ups</label><p class="agent-help">Follow-ups share the current run’s limits. Steering takes effect at the next safe boundary.</p></div>
            @if (_state.ActivePermissions is { } active)
            {
                <section class="agent-active-permissions"><h3>Active run authority</h3><p>@active.Policy.Profile · expires @active.ExpiresAt.ToLocalTime().ToString("T")</p>
                    <p>Editing selected preferences affects the next run. Revoke an active tool grant or stop this run to remove its current authority.</p>
                    @foreach (var tool in active.GrantedTools) { <div class="agent-rule"><code>@tool</code><button @onclick="() => RevokeGrantAsync(tool)">Revoke grant</button></div> }
                    @if (active.GrantedTools.Length == 0) { <p class="muted">No remembered tool approvals.</p> }
                    <button @onclick='() => CommandAsync("stop", new { })'>Stop and revoke all</button>
                </section>
            }
            <p class="muted">Host ceiling: @_state.Constraints.MaximumLease.TotalMinutes-minute lease · @(_state.Constraints.AllowRunApprovals ? "run approvals available" : "one-time approvals only"). @string.Join(", ", _state.Constraints.DeniedScopes.Select(scope => scope + " denied"))</p>
            <details class="agent-options" open>
                <summary>Run permissions and limits</summary>
                <p>Settings belong to the selected task. @(IsBrowser ? "These permissions are independent of external MCP access." : "The live project's companion access policy also applies to every operation.")</p>
                <fieldset class="agent-fieldset"><legend>Permission profile</legend>
                <label>Task permission profile <select aria-label="Task permission profile" @bind="_profile">@foreach (var profile in _state.Constraints.AllowedProfiles) { <option>@profile</option> }</select></label>
                <label><input type="checkbox" @bind="_neverAsk" /> Deny operations that require a review</label>
                <button @onclick="ResetPermissions">Reset task permissions</button>
                </fieldset>
                <fieldset class="agent-fieldset"><legend>Scope rules</legend><p class="agent-help">Override the profile for a specific part of Studio.</p><div class="agent-form-grid">
                @foreach (var scope in Scopes)
                {
                    <label>@scope <select value="@_scopes.GetValueOrDefault(scope, "default")" @onchange="args => ChangeScope(scope, args)"><option>default</option><option>allow</option><option>ask</option><option>deny</option></select></label>
                }
                </div></fieldset>
                <fieldset class="agent-tool-rules agent-fieldset"><legend>Exact tool rules</legend><p class="agent-help">Set a decision for an individual tool.</p>
                    <label>Tool <select aria-label="Permission tool" @bind="_ruleTool"><option value="">Choose a tool</option>@foreach (var tool in _toolCatalog) { <option value="@tool.Name">@tool.Name</option> }</select></label>
                    <label>Decision <select aria-label="Tool permission decision" @bind="_ruleDecision"><option>allow</option><option>ask</option><option>deny</option></select></label>
                    <button @onclick="SetToolRule" disabled="@string.IsNullOrEmpty(_ruleTool)">Set tool rule</button>
                    @foreach (var rule in ToolRuleValues) { <div class="agent-rule"><code>@rule.Key</code><strong>@rule.Value</strong><button @onclick="() => RemoveToolRule(rule.Key)">Remove rule</button></div> }
                </fieldset>
                <fieldset class="agent-fieldset"><legend>Run budgets</legend>
                <div class="agent-inline-actions"><button @onclick="() => SetPreset(false)">Extended limits</button><button @onclick="() => SetPreset(true)">Large limits</button></div>
                <div class="agent-form-grid">
                <label>Requests per run <input type="number" min="1" max="10000" @bind="_requests" /></label>
                <label>Tool calls per run <input type="number" min="1" max="10000" @bind="_tools" /></label>
                <label>@(selected.Account == null ? "Output tokens per request" : "Output reserve (not a cap)") <input type="number" min="1" max="1000000" @bind="_outputTokens" /></label>
                <label>Task token budget <input type="number" min="1" max="100000000" @bind="_taskTokens" /></label>
                <label>Context bytes <input type="number" min="1024" max="16000000" @bind="_contextBytes" /></label>
                <label>Tool result bytes <input type="number" min="1024" max="8388608" @bind="_toolResultBytes" /></label>
                <label>Automatic retries <input type="number" min="0" max="10" @bind="_retries" /></label>
                <label>Request timeout minutes <input type="number" min="1" max="30" @bind="_timeoutMinutes" /></label>
                <label>Lease minutes <input type="number" min="1" max="60" @bind="_leaseMinutes" /></label>
                </div><div class="agent-inline-actions"><button @onclick="SaveNumericPreferencesAsync">Save numeric defaults</button></div><p class="agent-help">Saved defaults contain numeric limits only. New tasks begin with Ask permissions.</p>
                </fieldset>
                <fieldset class="agent-fieldset"><legend>Context &amp; compaction</legend>
                <label><input type="checkbox" @bind="_autoCompact" /> Compact context automatically at complete tool boundaries</label>
                <label><input type="checkbox" @bind="Preferences.FullToolCatalog" /> Send every tool schema with every request</label>
                <p class="agent-help">By default, the agent discovers tools as needed to reduce request size. Every IDE tool remains available.</p>
                <div class="agent-form-grid">
                <label>Automatic compaction input tokens (0 disables this threshold) <input type="number" min="0" max="2000000" @bind="Preferences.Numeric.AutomaticInputTokens" /></label>
                <label>Model context window tokens (0 unspecified) <input type="number" min="0" max="4000000" @bind="Preferences.Numeric.ModelContextWindowTokens" /></label>
                <label>Recent complete turns to retain <input type="number" min="0" max="16" @bind="Preferences.Numeric.RecentCompleteTurns" /></label>
                <label>Checkpoint output tokens <input type="number" min="256" max="8192" @bind="Preferences.Numeric.CheckpointOutputTokens" /></label>
                </div></fieldset>
            </details>
            </section>
            <section class="agent-section agent-section-plan" hidden="@(!PaneVisible("Plan"))" aria-label="Agent plan">
            <div class="agent-section-heading"><div><h3>Task plan</h3><p>Track the agent’s approach and progress.</p></div><AgentIcon Name="Plan" /></div>
            @if (selected.ProposedPlan is { } proposed)
            { <div class="agent-proposed-plan"><AgentMarkdown Text="@proposed.Markdown" CopyRequested="CopyTextAsync" /><div class="agent-inline-actions"><button @onclick="() => CopyTextAsync(proposed.Markdown)">Copy plan</button><button class="primary" @onclick="ImplementPlan" disabled="@(AnyRunning || proposed.Accepted)">@(proposed.Accepted ? "Plan accepted" : "Implement plan")</button></div></div> }
            @if (selected.Plan.Length > 0)
            {
                <div class="agent-plan-progress"><span>@selected.Plan.Count(step => step.Status == "completed") of @selected.Plan.Length complete</span><progress value="@selected.Plan.Count(step => step.Status == "completed")" max="@selected.Plan.Length" aria-label="Plan progress"></progress></div>
                <ol class="agent-plan">@foreach (var step in selected.Plan) { <li data-status="@step.Status"><div><strong class="agent-status" data-status="@step.Status">@(step.Status == "inProgress" ? "in progress" : step.Status)</strong><p>@step.Text</p></div></li> }</ol>
            }
            @if (selected.Plan.Length == 0 && selected.ProposedPlan == null) { <div class="agent-empty"><span class="agent-empty-icon"><AgentIcon Name="Plan" /></span><h3>No plan yet</h3><p>The agent has not published a plan for this task. Ask it to plan the work in Conversation.</p><button @onclick='() => SelectSectionAsync("Conversation")'>Open conversation</button></div> }
            <p class="muted">Plan status is reported by the agent. Check its validation evidence in the conversation.</p>
            </section>
            <section class="agent-section agent-section-queue" hidden="@(!PaneVisible("Queue"))" aria-label="Agent queue">
            <div class="agent-section-heading"><div><h3>Follow-up queue</h3><p>Prepare the next requests without interrupting a run.</p></div><span class="agent-status">@selected.Queue.Messages.Length waiting</span></div>
            @if (selected.Queue.Messages.Length > 0)
            {
                <details class="agent-queue" open>
                    <summary>@selected.Queue.Messages.Length queued follow-ups</summary>
                    <p>Each message waits here until you select it and confirm a new run.</p>
                    <label>Queued message <select aria-label="Queued message" @key="selected.Queue.Revision" value="@QueueEdit.Id" disabled="@_queueBusy" @onchange='args => SelectQueue(args.Value?.ToString() ?? "")'>
                        @foreach (var message in selected.Queue.Messages) { <option @key="message.Id" value="@message.Id">@(message.Text.Length > 120 ? message.Text[..120] + "…" : message.Text)</option> }
                    </select></label>
                    <label>Edit queued message <textarea @bind="QueueEdit.Text" @bind:event="oninput" maxlength="100000" rows="4" /></label>
                    <div class="agent-inline-actions">
                    <button @onclick="SaveQueueAsync" disabled="@(_queueBusy || string.IsNullOrWhiteSpace(QueueEdit.Text))">Save queued edit</button>
                    <button @onclick="() => SelectQueue(QueueEdit.Id)" disabled="@_queueBusy">Reload queued message</button>
                    </div><div class="agent-inline-actions agent-queue-order"><span class="agent-help">Position @(QueueIndex + 1) of @selected.Queue.Messages.Length</span>
                    <button @onclick="() => MoveQueueAsync(-1)" disabled="@(_queueBusy || QueueIndex <= 0)">Move up</button>
                    <button @onclick="() => MoveQueueAsync(1)" disabled="@(_queueBusy || QueueIndex < 0 || QueueIndex >= selected.Queue.Messages.Length - 1)">Move down</button>
                    </div><div class="agent-inline-actions">
                    <button class="agent-danger" @onclick="RemoveQueueAsync" disabled="@_queueBusy">Remove queued message</button>
                    </div><div class="agent-panel-footer">
                    <button class="primary" @onclick="ReviewQueuedRun" disabled="@(selected.IsPreviousWorkspace || _queueBusy || AnyRunning || selected.Status is not ("ready" or "completed") || QueueIndex < 0)">Send selected message</button>
                    <button class="agent-danger" @onclick="ClearQueueAsync" disabled="@_queueBusy">Clear queue</button>
                    </div>
                </details>
            }
            @if (selected.Queue.Messages.Length == 0) { <div class="agent-empty"><span class="agent-empty-icon"><AgentIcon Name="Queue" /></span><h3>Your queue is empty</h3><p>Draft a message in Conversation, then choose Queue follow-up. You review each message before it runs.</p><button @onclick='() => SelectSectionAsync("Conversation")'>Draft a follow-up</button></div> }
            </section>
            <section class="agent-section agent-section-changes" hidden="@(!PaneVisible("Changes"))" aria-label="Agent changes">
            <div class="agent-section-heading"><div><h3>Source changes</h3><p>Review, give feedback, or restore source edits.</p></div><AgentIcon Name="Changes" /></div>
            <div class="agent-filter-bar">
            <label>Source comparison <select value="@(_latestRun ? "latest" : "task")" @onchange="ChangeBaselineAsync" disabled="@Review.Busy"><option value="task">Since task start</option><option value="latest">Since latest run</option></select></label>
            <button @onclick="RefreshReviewAsync" disabled="@(selected.IsPreviousWorkspace || AnyRunning || Review.Busy || SelectedChanges == null)">Refresh changes</button>
            </div>
            @if (Review.Capture is { } changes)
            {
                <details class="agent-changes" open>
                    <summary>Review @changes.Files.Length changed source files</summary>
                    <p>This includes manual and other-task edits since the checkpoint.</p>
                    @if (!ReviewIsCurrent) { <p role="status">Source or checkpoint changed. Refresh changes before feedback, navigation or restoration.</p> }
                    @foreach (var file in changes.Files)
                    {
                        <label class="agent-change-file"><input type="checkbox" checked="@_restorePaths.Contains(file.Path)" @onchange="args => SelectRestore(file.Path, args)" disabled="@(!ReviewIsCurrent)" /> @file.Path (@file.BeforeLength → @file.AfterLength characters)</label>
                    }
                    <div class="agent-inline-actions"><button @onclick="ReviewRestore" disabled="@(!ReviewIsCurrent || AnyRunning || _restorePaths.Count == 0)">Restore selected files</button>
                    <button @onclick="ExportPatchAsync" disabled="@Review.Busy">Save review patch</button></div>
                    @if (changes.Files.Length == 0) { <div class="agent-empty"><span class="agent-empty-icon"><AgentIcon Name="Changes" /></span><h3>No source changes</h3><p>The project matches this checkpoint.</p></div> }
                    @if (changes.Files.Length > 0)
                    {
                        <label>Review document <select @key="(_selectedId, changes.ReviewId)" value="@Review.Path" @onchange="SelectReviewFileAsync" disabled="@Review.Busy">@foreach (var file in changes.Files) { <option value="@file.Path">@file.Path</option> }</select></label>
                        <div class="agent-inline-actions"><button @onclick="OpenReviewSourceAsync" disabled="@(!ReviewIsCurrent || changes.Files.FirstOrDefault(file => file.Path == Review.Path)?.AfterLength == null)">Open current document</button>
                        <button @onclick="PreviewChangesAsync" disabled="@Review.Busy">Show before and after</button>
                        <button @onclick="PreviewDiffAsync" disabled="@Review.Busy">Unified diff</button></div>
                    }
                    @if (Review.Preview is { } preview)
                    { <div class="agent-source-preview"><section><h4>Before · @preview.Path</h4><pre>@preview.Before</pre></section><section><h4>After</h4><pre>@preview.After</pre></section></div> }
                    @if (Review.Diff is { } diff)
                    {
                        @if (diff.Coarse) { <p>Large changed region shown as replacement lines.</p> }
                        @if (diff.Truncated) { <p>Display excerpt; save the review patch for the complete captured changes.</p> }
                        @if (!diff.SelectiveRestoreAvailable) { <p>Individual block restoration requires an existing document within the interactive line limit. Whole-file restoration remains available.</p> }
                        <div class="agent-task-actions">
                            <button @onclick="() => MoveBlockAsync(-1)" disabled="@(Review.Busy || BlockIndex <= 0)">Previous change</button>
                            <span aria-label="Selected change block">@(BlockIndex < 0 ? "No change block selected" : $"Change {BlockIndex + 1} of {diff.Blocks.Length}")</span>
                            <button @onclick="() => MoveBlockAsync(1)" disabled="@(Review.Busy || BlockIndex >= diff.Blocks.Length - 1)">Next change</button>
                            <button @onclick="ReviewBlockRestoreAsync" disabled="@(!ReviewIsCurrent || AnyRunning || Review.Busy || !diff.SelectiveRestoreAvailable || BlockIndex < 0)">Restore selected change</button>
                        </div>
                        <div class="agent-diff" data-review-key="@DiffScrollKey" @ref="_diffElement">@foreach (var line in diff.Lines)
                        {
                            <button class="diff-@line.Kind @(line.BlockId == Review.BlockId ? "diff-selected" : "")" data-block-id="@line.BlockId" @onclick="() => SelectDiffLine(line)">
                                <span>@line.BeforeLine</span><span>@line.AfterLine</span><span>@(line.Kind == "added" ? "+" : line.Kind == "removed" ? "−" : " ")</span><code>@line.Text</code>
                                <small title="Line ending">@(line.Kind == "context" ? "" : line.LineEnding == "none" ? "no final newline" : line.LineEnding)</small>
                            </button>
                        }</div>
                        @if (diff.TotalRows > 0)
                        {
                            <p>Rows @(diff.FirstRow + 1)–@(diff.FirstRow + diff.Lines.Length) of @diff.TotalRows</p>
                            <button @onclick="MoreDiffAsync" disabled="@(Review.Busy || Review.LineLimit >= 10000 || diff.FirstRow + diff.Lines.Length >= diff.TotalRows)">Show more diff lines</button>
                            <button @onclick="() => PageDiffAsync(-1)" disabled="@(Review.Busy || diff.FirstRow == 0)">Previous diff lines</button>
                            <button @onclick="() => PageDiffAsync(1)" disabled="@(Review.Busy || diff.FirstRow + diff.Lines.Length >= diff.TotalRows)">Next diff lines</button>
                        }
                    }
                    <label>Review feedback <textarea value="@Review.Feedback" @oninput="ReviewFeedbackChanged" maxlength="8000" rows="3" /></label>
                    @if (Review.FeedbackPath.Length != 0) { <p>Feedback for @Review.FeedbackPath</p> }
                    @if (Review.FeedbackTarget != null) { <p>A selected diff line is attached to this feedback.</p><button @onclick="() => Review.FeedbackTarget = null">Clear line target</button> }
                    <button @onclick="QueueReviewFeedbackAsync" disabled="@(!ReviewIsCurrent || _queueBusy || string.IsNullOrWhiteSpace(Review.Feedback))">Queue review feedback</button>
                </details>
            }
            else { <div class="agent-empty"><span class="agent-empty-icon"><AgentIcon Name="Changes" /></span><h3>No comparison yet</h3><p>Source changes will appear here after a run. Refresh to compare the current project with its checkpoint.</p></div> }
            </section>
        }
        else if (_section is "Conversation" or "Plan" or "Changes" or "Queue" or "Permissions")
        { <div class="agent-empty"><h3>Start a task</h3><p>Choose a provider and model, then create a task. Each task keeps its own conversation, plan, source review, and permissions.</p><button @onclick='() => SelectSectionAsync("Tasks")'>New task</button></div> }
            <section class="agent-section agent-section-tools" hidden="@(!PaneVisible("Tools"))" aria-label="Agent tools">
                <div class="agent-section-heading"><div><h3>Available tools</h3><p>Explore the agent’s access to this workspace.</p></div><button @onclick="LoadToolsAsync">Refresh catalog</button></div>
                <div class="agent-filter-bar">
                <label>Search tools <input @bind="_toolFilter" @bind:event="oninput" placeholder="Name or description" /></label>
                <label>Scope <select @bind="_toolScope"><option value="">All scopes</option>@foreach (var scope in Scopes) { <option>@scope</option> }</select></label>
                </div>
                <div class="agent-result-summary"><span class="agent-status">@VisibleTools.Count() tools</span><span class="agent-help">Each operation follows the task’s permissions.</span></div>
                @foreach (var tool in VisibleTools)
                {
                    <details class="agent-catalog-tool"><summary><code>@tool.Name</code><span class="agent-tool-tags"><span>@tool.Scope</span><span>@tool.Effect</span>@if (tool.Destructive) { <span class="agent-danger">destructive</span> }</span></summary>
                        <p>@tool.Description</p>
                        @foreach (var effect in tool.AdditionalEffects ?? []) { <p>Also affects @effect.Scope · @effect.Effect</p> }
                        <h4>Input schema</h4>
                        <pre>@JsonSerializer.Serialize(tool.InputSchema, new JsonSerializerOptions { WriteIndented = true })</pre>
                    </details>
                }
                @if (!VisibleTools.Any()) { <div class="agent-empty"><span class="agent-empty-icon"><AgentIcon Name="Tools" /></span><h3>No matching tools</h3><p>Try another name, description, or scope.</p><button @onclick='() => { _toolFilter = ""; _toolScope = ""; }'>Clear tool filters</button></div> }
            </section>
            <section class="agent-section agent-section-activity" hidden="@(!PaneVisible("Activity"))" aria-label="Agent activity">
                <div class="agent-section-heading"><div><h3>Activity</h3><p>Requests, tools, and task events in one place.</p></div><button @onclick="LoadActivityAsync">Refresh activity</button></div>
                <div class="agent-card agent-activity-filters">
                <label>Filter activity <input @bind="_agentActivityFilter" @bind:event="oninput" placeholder="Search events" /></label>
                <label><input type="checkbox" @bind="_activityCurrentTask" /> Selected task only</label>
                <div class="agent-task-actions"><button @onclick="ExportAgentActivityAsync">Export activity</button><button class="agent-danger" @onclick="ClearAgentActivityAsync">Clear activity</button></div>
                </div>
                <div class="agent-result-summary"><span class="agent-status">@VisibleActivity.Count() events</span><span class="agent-help">Most recent 500 events, up to 512 KiB.</span></div>
                <div class="agent-activity-list">
                @foreach (var item in VisibleActivity.Reverse()) { <article class="agent-activity-entry" @key="item.Sequence"><time datetime="@item.Time.ToString("O")">@item.Time.ToLocalTime().ToString("T")</time><AgentEventCard Kind="@item.Kind" Text="@item.Text" ToolName="@item.ToolName" ResultPreview="item.ResultPreview" Historical="true" CopyRequested="CopyTextAsync" /></article> }
                </div>
                @if (!VisibleActivity.Any()) { <div class="agent-empty"><span class="agent-empty-icon"><AgentIcon Name="Activity" /></span><h3>No activity to show</h3><p>Events appear as the agent works. Adjust the filters to include other tasks or event types.</p></div> }
        @if (!IsBrowser) { <details class="agent-operations">
            <summary>MCP operations (@(_state.Operations?.Length ?? 0))</summary>
            <p>Background waits expire after two minutes. Cancelling stops a wait immediately.</p>
            <button @onclick='() => CommandAsync("operations_clear", new { })'>Clear finished operations</button>
            @foreach (var operation in _state.Operations ?? [])
            {
                <div class="agent-operation"><code>@operation.TaskId</code> · @operation.Status · @operation.CreatedAt.ToLocalTime().ToString("T")
                    <button disabled='@(operation.Status != "Working")' @onclick='() => CommandAsync("operation_cancel", new { id = operation.TaskId })'>Cancel operation</button>
                </div>
            }
        </details> }
            </section>
    }
    </div>
    </div>
    @if (_showGoalEditor)
    {
        <div class="authoring-backdrop"><section class="authoring-dialog agent-dialog" role="dialog" aria-modal="true" aria-label="Set a goal"><h2>What should be true when we’re done?</h2><p>The agent keeps working toward this objective across turns. You can pause or resume it at any time.</p><label>Goal <textarea @bind="_goalObjective" @bind:event="oninput" rows="5" maxlength="100000" placeholder="Describe the outcome and how to verify it…" /></label><label>Token budget (optional) <input type="number" @bind="_goalBudget" min="1" max="100000000" placeholder="No goal-specific limit" /></label><footer><button @onclick="() => _showGoalEditor = false">Cancel</button><button class="primary" @onclick="StartGoalAsync" disabled="@(_sending || _goalBusy || string.IsNullOrWhiteSpace(_goalObjective))">Start goal</button></footer></section></div>
    }
    @if (_deleteTaskId is { } deleting)
    {
        <div class="authoring-backdrop"><section class="authoring-dialog agent-dialog" role="dialog" aria-modal="true" aria-label="Delete agent task"><h2>Delete task?</h2>
            <p>Delete @_state.Tasks.FirstOrDefault(task => task.Id == deleting)?.Name and its conversation, queue, and source checkpoints. Project source is retained.</p>
            <footer><button @onclick="() => _deleteTaskId = null">Cancel</button><button @onclick="DeleteTaskAsync">Delete task permanently</button></footer>
        </section></div>
    }
    @if (_error != null) { <p class="runtime-error" role="alert">@_error</p> }
    @if (_handoff != null)
    {
        <div class="authoring-backdrop"><section class="authoring-dialog agent-dialog" role="dialog" aria-modal="true" aria-label="Review task context">
            <h2>New task with context</h2><p>Edit this public excerpt, then create a draft for a new task. Run it after reviewing its own permissions.</p>
            <label>New task name <input @bind="_name" maxlength="200" /></label>
            <label>Provider <select @bind="_provider" @bind:after="ProviderChanged">@foreach (var provider in _state.Providers) { <option value="@provider">@ProviderLabel(provider)</option> }</select></label>
            @if (_provider == ChatGptProvider) { <p>ChatGPT account: @(ActiveAccount?.Label ?? "Select and sign in to an account before creating this task").</p> }
            <label>Model <input @bind="_model" @bind:event="oninput" /></label>
            <textarea aria-label="Context handoff" @bind="_handoff" maxlength="262144" rows="16" />
            <footer><button @onclick="() => _handoff = null" disabled="@_handoffBusy">Cancel</button><button @onclick="CreateWithContextAsync" disabled="@(_handoffBusy || _state.Tasks.Length >= 8 || !ProviderReady || string.IsNullOrWhiteSpace(_model))">Create with reviewed context</button></footer>
        </section></div>
    }
    @if (_restoreReview is { } restore)
    {
        <div class="authoring-backdrop"><section class="authoring-dialog agent-dialog" role="dialog" aria-modal="true" aria-label="Review source restore">
            <h2>@(restore.Block == null ? "Restore selected source" : "Restore selected change")</h2>
            <p>Restore @(restore.Block == null ? "these files" : "this block") to the @(restore.LatestRun ? "latest-run" : "task-start") checkpoint at reviewed revision @restore.Revision. This comparison includes manual edits made during the task. Restoration creates a normal project undo step.</p>
            <ul>@foreach (var path in restore.Paths) { <li>@path</li> }</ul>
            @if (restore.Block is { } block)
            {
                <p>+@block.Block.AddedLines / −@block.Block.RemovedLines lines. Other changes in this document are preserved. The entire current document must still match the reviewed source.</p>
                @if (block.Coarse) { <p>This block replaces the complete large changed region.</p> }
                @if (block.Truncated) { <p>Shortened previews; save the review patch to inspect the complete block.</p> }
                <h4>Current block</h4><pre>@block.After</pre><h4>Checkpoint block</h4><pre>@block.Before</pre>
            }
            <footer><button @onclick="() => _restoreReview = null" disabled="@_restoreBusy">Cancel</button><button @onclick="ConfirmRestoreAsync" disabled="@(_restoreBusy || AnyRunning || SourceRevision != restore.Revision)">Confirm source restore</button></footer>
            @if (_error != null) { <p role="alert">@_error</p> }
        </section></div>
    }
    @if (_runReview is { } review)
    {
        <div class="authoring-backdrop" @onkeydown='args => { if (args.Key == "Escape") CancelRunReview(); }' @onkeydown:stopPropagation="true">
            <section class="authoring-dialog agent-dialog" role="dialog" aria-modal="true" aria-label="Review agent run">
                <header><h2>@(review.Compact ? "Review context compaction" : "Review agent run")</h2></header>
                <p><strong>@review.Name</strong> · @review.Provider · @review.Model</p>
                <p>This run uses the current live project. Permission profile: <strong>@review.Profile</strong>.</p>
                <p>@review.Limits</p>
                <details><summary>Scope and exact tool rules</summary><pre>@review.Options.GetProperty("policy").GetRawText()</pre></details>
                <pre class="agent-run-preview">@(review.Preview ?? "Resume the pending turn with its completed tool results.")</pre>
                @if (review.Profile == "fullAccess")
                {
                    <label><input type="checkbox" @bind="_fullAccessAcknowledged" /> Allow Full Access for this run, including runtime execution permitted by the live project</label>
                }
                <footer>
                    <button @onclick="CancelRunReview" disabled="@_reviewBusy" @ref="_runReviewCancel">Cancel</button>
                    <button class="primary" @onclick="ConfirmRunAsync" disabled="@(_reviewBusy || (review.Profile == "fullAccess" && !_fullAccessAcknowledged))">@(review.Compact ? "Confirm compaction" : "Confirm run")</button>
                </footer>
                @if (_error != null) { <p class="runtime-error" role="alert">@_error</p> }
            </section>
        </div>
    }
</section>
