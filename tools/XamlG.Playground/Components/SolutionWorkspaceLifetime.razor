@using Microsoft.JSInterop
@using XamlG.Playground.Workspaces
@implements IAsyncDisposable
@inject IJSRuntime JavaScript

@code {
    [Parameter, EditorRequired] public SolutionWorkspaceSession Session { get; set; } = default!;
    [Parameter] public EventCallback Changed { get; set; }
    private IJSObjectReference? _module, _shortcuts;
    private DotNetObjectReference<SolutionWorkspaceLifetime>? _reference;
    private bool _disposed;

    protected override void OnInitialized() => Session.Changed += SessionChanged;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await Session.InitializeAsync(JavaScript);
        if (_disposed) return;
        _module = await JavaScript.InvokeAsync<IJSObjectReference>("xamlgBoot.importModule", "solution-workspace.js");
        _reference = DotNetObjectReference.Create(this);
        _shortcuts = await _module.InvokeAsync<IJSObjectReference>("installShortcuts", _reference);
        await Changed.InvokeAsync();
    }
    private void SessionChanged()
    {
        if (_disposed) return;
        _ = InvokeAsync(async () =>
        {
            if (_disposed) return;
            if (_module != null)
            {
                try { await _module.InvokeVoidAsync("setUnsavedChanges", Session.HasUnsavedChanges); }
                catch (JSDisconnectedException) { return; }
            }
            await Changed.InvokeAsync();
        });
    }
    [JSInvokable] public Task SaveWorkspaceDocuments() => Session.SaveAllAsync();
    public async ValueTask DisposeAsync()
    {
        _disposed = true; Session.Changed -= SessionChanged;
        try
        {
            if (_shortcuts != null) { await _shortcuts.InvokeVoidAsync("dispose"); await _shortcuts.DisposeAsync(); }
            if (_module != null) await _module.DisposeAsync();
            await Session.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        finally { _reference?.Dispose(); }
    }
}
