@if (Visible)
{
    <div class="authoring-overlay" @onclick="Cancel">
        <section class="authoring-dialog" role="dialog" aria-modal="true" aria-label="Rename resource file" @onclick:stopPropagation="true">
            <header><h2>Rename resource file</h2><button aria-label="Close dialog" @onclick="Cancel">×</button></header>
            <p>Move a project resource and update incoming and outgoing include URIs atomically.</p>
            <label>Current resource<input value="@OldPath" readonly /></label>
            <label>New resource path<input value="@NewPath" @oninput="PathChanged" spellcheck="false" /></label>
            @if (Error != null) { <div class="runtime-error" role="alert">@Error</div> }
            @if (Plan is { Success: true } plan)
            {
                <div class="authoring-preview">
                    <h3>@plan.Files.Length affected document(s)</h3>
                    @foreach (var file in plan.Files)
                    {
                        <details open>
                            <summary>@file.OldPath → @file.NewPath</summary>
                            <pre>@file.NewText</pre>
                        </details>
                    }
                </div>
            }
            <footer>
                <button @onclick="Cancel">Cancel</button>
                <button @onclick="Preview" disabled="@Busy">Preview changes</button>
                <button class="primary" @onclick="Apply" disabled="@(Busy || Plan == null || !Plan.Success)">Apply rename</button>
            </footer>
        </section>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public string OldPath { get; set; } = string.Empty;
    [Parameter] public string NewPath { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> NewPathChanged { get; set; }
    [Parameter] public XamlG.Tooling.Resources.XamlResourceRefactoringResult? Plan { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback Preview { get; set; }
    [Parameter] public EventCallback Apply { get; set; }
    [Parameter] public EventCallback Cancel { get; set; }
    private Task PathChanged(ChangeEventArgs args) => NewPathChanged.InvokeAsync(args.Value?.ToString() ?? string.Empty);
}
