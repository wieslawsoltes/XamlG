<section class="structure-editor">
    <h3>Structure</h3>
    <label>Destination
        <select value="@Destination" @onchange="DestinationChangedAsync" aria-label="Reparent destination">
            <option value="-1">Choose parent…</option>
            @foreach (var item in Destinations) { <option value="@item.Span.Start">@item.Name · @item.Span.Start</option> }
        </select>
    </label>
    <button @onclick="Reparent" disabled="@(Disabled || Destination < 0)">Move into parent</button>
    <label>New child<input value="@Markup" @onchange="MarkupChangedAsync" aria-label="New child XAML" /></label>
    <button @onclick="Insert" disabled="@Disabled">Insert child</button>
    <button @onclick="Remove" disabled="@(Disabled || IsRoot)">Remove element</button>
</section>

@code {
    [Parameter] public IEnumerable<XamlElementSyntax> Destinations { get; set; } = Array.Empty<XamlElementSyntax>();
    [Parameter] public int Destination { get; set; }
    [Parameter] public EventCallback<int> DestinationChanged { get; set; }
    [Parameter] public string Markup { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> MarkupChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool IsRoot { get; set; }
    [Parameter] public EventCallback Reparent { get; set; }
    [Parameter] public EventCallback Insert { get; set; }
    [Parameter] public EventCallback Remove { get; set; }
    private Task DestinationChangedAsync(ChangeEventArgs args) => DestinationChanged.InvokeAsync(int.TryParse(args.Value?.ToString(), out var value) ? value : -1);
    private Task MarkupChangedAsync(ChangeEventArgs args) => MarkupChanged.InvokeAsync(args.Value?.ToString() ?? string.Empty);
}
