<div class="designer-commands">
    <button data-testid="design-mode" class="@(Enabled ? "primary" : "")" disabled="@Disabled" aria-pressed="@Enabled" @onclick="Toggle">@(Enabled ? "◈ Design mode" : "◈ Design")</button>
    @if (Enabled) { <small>Ctrl/⌘ click selects a group · drag · resize · Shift aspect · Alt free</small> }
</div>

@code {
    [Parameter] public bool Enabled { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback Toggle { get; set; }
}
